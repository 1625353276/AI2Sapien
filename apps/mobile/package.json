{
  "name": "@ai2sapien/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "AI2Sapien Android/iOS companion shell.",
  "main": "index.ts",
  "scripts": {
    "start": "node ../../node_modules/expo/bin/cli start",
    "android": "node ../../node_modules/expo/bin/cli start --android",
    "ios": "node ../../node_modules/expo/bin/cli start --ios",
    "web": "node ../../node_modules/expo/bin/cli start --web",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai2sapien/contracts": "*",
    "expo": "~57.0.0",
    "expo-status-bar": "~55.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2"
  }
}
